{
    "name": "animal-island-wx",
    "version": "0.1.0",
    "description": "Animal Island UI 的微信小程序原生组件库（WXML/WXSS/TS），移植自动物岛风格的 animal-island-ui",
    "keywords": [
        "weapp",
        "miniprogram",
        "wechat",
        "component",
        "ui",
        "wxml",
        "taro",
        "uni-app",
        "animal-island"
    ],
    "license": "MIT",
    "author": "lns567",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lns567/animal-island-wx.git"
    },
    "homepage": "https://github.com/lns567/animal-island-wx#readme",
    "bugs": {
        "url": "https://github.com/lns567/animal-island-wx/issues"
    },
    "main": "miniprogram_dist/index.js",
    "miniprogram": "miniprogram_dist",
    "files": [
        "miniprogram_dist",
        "README.md",
        "LICENSE",
        "THIRD-PARTY-NOTICES.md"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "icons": "node scripts/gen-icons.mjs",
        "preview": "node scripts/build.mjs && node scripts/build-preview.mjs",
        "preview:shot": "node scripts/build.mjs && node scripts/build-preview.mjs && node scripts/screenshot.mjs",
        "check": "node scripts/check.mjs",
        "ci": "npm run build && npm run check && node scripts/build-preview.mjs",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "miniprogram-api-typings": "^4.0.1",
        "typescript": "^5.7.3"
    }
}
