@import '../common/style/base.wxss';

/* ============================================
 * ai-avatar —— 对应 Web 版 Avatar
 * 圆形/方形、图片/图标/文字三种内容形态
 * ============================================ */

:host {
    display: inline-block;
    vertical-align: middle;
}

.ai-avatar {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    vertical-align: middle;
    background-color: var(--animal-primary-color-bg, #e6f9f6);
    color: var(--animal-primary-color, #19c8b9);
    font-weight: 600;
    border-radius: 999px;
}

.ai-avatar--square {
    border-radius: 8px;
}

/* 占位（图标/文字）形态：奶油色描边增加贴纸感 */
.ai-avatar--placeholder {
    border: 2px solid var(--animal-bg-color, #f8f8f0);
}

.ai-avatar__img {
    display: block;
    width: 100%;
    height: 100%;
}

.ai-avatar__string {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    white-space: nowrap;
}
