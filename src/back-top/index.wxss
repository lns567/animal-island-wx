@import '../common/style/base.wxss';

/* ============================================
 * ai-backtop —— 对应 Web 版 BackTop
 * 右下角悬浮火箭，无底板；点击平滑滚回页面顶部
 * ============================================ */

:host {
    display: contents;
}

.ai-backtop {
    position: fixed;
    right: 24px;
    bottom: 32px;
    z-index: 1000;
    display: block;
    width: 64px;
    height: 64px;
    line-height: 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.ai-backtop--visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.ai-backtop__img {
    display: block;
    width: 64px;
    height: 64px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 64px 64px;
    background-image: url('data:image/svg+xml;base64,');
    filter: drop-shadow(0 4px 10px rgba(91, 78, 30, 0.22));
    transition: filter 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.ai-backtop--hover .ai-backtop__img {
    filter: drop-shadow(0 4px 14px rgba(91, 78, 30, 0.32));
}
