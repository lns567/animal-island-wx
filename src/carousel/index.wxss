@import '../common/style/base.wxss';

/* ============================================
 * ai-carousel —— 对应 Web 版 Carousel
 * 卡片圆角 20 + 奶油底 + 圆形箭头 + 胶囊圆点
 * ============================================ */

:host {
    display: block;
}

.ai-carousel {
    position: relative;
    width: 100%;
    min-width: 0;
    border-radius: 20px;
}

.ai-carousel__viewport {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    background: rgb(247, 243, 223);
}

.ai-carousel__swiper {
    width: 100%;
    height: 100%;
}

.ai-carousel__item {
    display: block;
}

.ai-carousel__card {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.ai-carousel__img {
    display: block;
    width: 100%;
    height: 100%;
}

.ai-carousel__caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 28px 18px 16px;
    background-image: linear-gradient(180deg, rgba(61, 52, 40, 0) 0%, rgba(61, 52, 40, 0.55) 100%);
}

.ai-carousel__title {
    color: #ffffff;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.35;
}

.ai-carousel__desc {
    color: rgba(255, 255, 255, 0.86);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
}

/* ---------- 左右箭头 ---------- */
.ai-carousel__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 42px;
    height: 42px;
    box-sizing: border-box;
    border: 1.5px solid rgba(121, 79, 39, 0.16);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 2px 4px rgba(61, 52, 40, 0.06);
    transform: translateY(-50%);
}

.ai-carousel__arrow::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 9px;
    height: 9px;
    border-top: 3px solid #794f27;
    border-left: 3px solid #794f27;
}

.ai-carousel__arrow--prev {
    left: 14px;
}

.ai-carousel__arrow--prev::before {
    transform: translate(-35%, -50%) rotate(-45deg);
}

.ai-carousel__arrow--next {
    right: 14px;
}

.ai-carousel__arrow--next::before {
    transform: translate(-65%, -50%) rotate(135deg);
}

.ai-carousel__arrow--hover {
    border-color: rgba(25, 200, 185, 0.5);
}

/* ---------- 圆点 ---------- */
.ai-carousel__dots {
    position: absolute;
    bottom: 14px;
    left: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 7px 10px;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.85);
    transform: translateX(-50%);
}

.ai-carousel__dot {
    position: relative;
    width: 30px;
    height: 30px;
}

.ai-carousel__dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50px;
    background: #d4c9b4;
    transform: translate(-50%, -50%);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.ai-carousel__dot--active::before {
    width: 24px;
    background: #19c8b9;
}

/* ---------- 播放/暂停 ---------- */
.ai-carousel__rotation {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 3;
    min-width: 58px;
    height: 32px;
    box-sizing: border-box;
    padding: 0 12px;
    border: 1.5px solid rgba(121, 79, 39, 0.16);
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.92);
    color: #794f27;
    font-size: 12px;
    font-weight: 700;
    line-height: 29px;
    text-align: center;
}
