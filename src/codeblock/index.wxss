@import '../common/style/base.wxss';

/* ============================================
 * ai-codeblock —— 对应 Web 版 CodeBlock
 * 深色奶油底 + 关键字着色 + 复制按钮
 * ============================================ */

:host {
    display: block;
}

.ai-codeblock {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    margin: 1em 0;
    background: #2b2118;
    border: 1px solid #3d3028;
    border-radius: 20px;
    overflow: hidden;
}

/* ---------- 顶部条（语言角标 / 复制按钮） ---------- */
.ai-codeblock__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px 0 24px;
    min-height: 32px;
}

.ai-codeblock__lang {
    color: rgba(232, 213, 188, 0.55);
    font-family: var(--animal-font-family, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.ai-codeblock__copy {
    min-width: 62px;
    height: 32px;
    padding: 0 12px;
    border: 1px solid rgba(232, 213, 188, 0.3);
    border-radius: 50px;
    background: rgba(61, 48, 40, 0.94);
    color: #e8d5bc;
    font-family: var(--animal-font-family, sans-serif);
    font-size: 12px;
    font-weight: 700;
    line-height: 30px;
    text-align: center;
    transition: all var(--animal-motion-duration-base, 0.25s) var(--animal-motion-ease, cubic-bezier(0.4, 0, 0.2, 1));
}

.ai-codeblock__copy--hover {
    background: #4b3b31;
}

.ai-codeblock__copy--copied {
    border-color: rgba(130, 213, 187, 0.7);
    color: #82d5bb;
}

.ai-codeblock__copy--error {
    border-color: rgba(224, 90, 90, 0.7);
    color: #e06c75;
}

/* ---------- 代码区 ---------- */
.ai-codeblock__scroll {
    width: 100%;
    white-space: nowrap;
}

.ai-codeblock__body {
    display: inline-block;
    min-width: 100%;
    padding: 12px 24px 20px;
}

.ai-codeblock__line {
    display: flex;
    align-items: flex-start;
    min-height: 24px;
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.7;
    white-space: pre;
}

.ai-codeblock__no {
    flex: none;
    width: 28px;
    margin-right: 14px;
    color: rgba(232, 213, 188, 0.32);
    text-align: right;
    user-select: none;
}

.ai-codeblock__code {
    flex: 1;
    color: #e8d5bc;
    white-space: pre;
}

/* ---------- Token 配色（照搬 Web 版 COLORS） ---------- */
.ai-codeblock__t--default {
    color: #e8d5bc;
}

.ai-codeblock__t--comment {
    color: #6b5e50;
}

.ai-codeblock__t--string {
    color: #a8d4a0;
}

.ai-codeblock__t--keyword {
    color: #d4a0e0;
}

.ai-codeblock__t--react {
    color: #e06c75;
}

.ai-codeblock__t--component {
    color: #80c0e0;
}

.ai-codeblock__t--func {
    color: #61afef;
}

.ai-codeblock__t--prop {
    color: #e8c87a;
}

.ai-codeblock__t--jsx {
    color: #f0a870;
}

.ai-codeblock__t--operator {
    color: #d4b896;
}

.ai-codeblock__t--number {
    color: #a8d4a0;
}
