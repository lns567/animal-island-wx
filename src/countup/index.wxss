@import '../common/style/base.wxss';

/* ============================================
 * ai-countup —— 对应 Web 版 CountUp
 * 两套皮肤（default / island）+ 结束庆祝动效
 * ============================================ */

:host {
    display: inline-block;
}

.ai-countup {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--animal-spacing-sm, 8px);
    box-sizing: border-box;
    max-width: 100%;
    color: var(--animal-text-color, #794f27);
    font-weight: 700;
    border-radius: 20px;
    transition: transform var(--animal-motion-duration-base, 0.2s) var(--animal-motion-ease, cubic-bezier(0.4, 0, 0.2, 1));
}

/* ---------- 外壳 ---------- */

.ai-countup--default {
    padding: 12px 18px;
    background: var(--animal-bg-color, #ffffff);
    box-shadow: var(--animal-shadow-sm, 0 2px 4px rgba(61, 52, 40, 0.06));
}

.ai-countup--island {
    padding: 13px 20px;
    background: #f7f3df;
    border: 2px dashed #d4c4a8;
}

/* ---------- 数字块 ---------- */

.ai-countup__plate-wrap {
    position: relative;
    display: inline-flex;
}

.ai-countup__plate {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    box-sizing: border-box;
    padding: 3px 8px;
    background: linear-gradient(180deg, #ffffff 0%, #f8f8f0 100%);
    border-radius: 12px;
}

.ai-countup--island .ai-countup__plate {
    background: linear-gradient(180deg, #fffdf4 0%, #f8f8f0 100%);
}

.ai-countup--bordered .ai-countup__plate {
    border: 1.5px solid #d4c9b4;
}

.ai-countup--bordered.ai-countup--island .ai-countup__plate {
    border-color: #d4c4a8;
}

.ai-countup__number {
    color: #8b7355;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    line-height: 1.2;
}

/* 前后缀比数字小一档，弱化成单位而不是主角 */
.ai-countup__affix {
    color: #a89878;
    font-weight: 800;
    font-size: 0.62em;
    line-height: 1.2;
    white-space: nowrap;
}

/* ---------- 尺寸 ---------- */

.ai-countup--small {
    min-height: 40px;
    font-size: 13px;
}

.ai-countup--small .ai-countup__number {
    font-size: 20px;
}

.ai-countup--small .ai-countup__badge {
    font-size: 12px;
}

.ai-countup--middle {
    min-height: 48px;
    font-size: 14px;
}

.ai-countup--middle .ai-countup__number {
    font-size: 26px;
}

.ai-countup--middle .ai-countup__badge {
    font-size: 13px;
}

.ai-countup--large {
    min-height: 56px;
    font-size: 16px;
}

.ai-countup--large .ai-countup__number {
    font-size: 34px;
}

.ai-countup--large .ai-countup__badge {
    font-size: 15px;
}

/* ---------- 结束庆祝 ---------- */

/* 动画层绝对定位铺满数字块，不参与布局 */
.ai-countup__effects {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
}

.ai-countup.is-celebrating .ai-countup__plate {
    animation: ai-countup-pop 0.7s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* 两圈向外扩散的光环，错开 0.12s */
.ai-countup__ring {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    border: 2px solid rgba(247, 205, 103, 0.85);
    border-radius: 14px;
    animation: ai-countup-ring 0.7s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.ai-countup__ring--2 {
    border-color: rgba(255, 204, 0, 0.7);
    animation-delay: 0.12s;
}

.ai-countup__sparkles {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

/* 四角星芒：纯 CSS 四角星，向外飞散后淡出 */
.ai-countup__sparkle {
    position: absolute;
    width: 10px;
    height: 10px;
    background: #f7cd67;
    clip-path: polygon(50% 0%, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0% 50%, 39% 39%);
    animation: ai-countup-sparkle 0.72s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.ai-countup__sparkle--1 {
    top: 0;
    left: 0;
    --cu-x: -16px;
    --cu-y: -14px;
}

.ai-countup__sparkle--2 {
    top: 0;
    right: 0;
    --cu-x: 16px;
    --cu-y: -12px;
    animation-delay: 0.06s;
}

.ai-countup__sparkle--3 {
    bottom: 0;
    left: 0;
    --cu-x: -16px;
    --cu-y: 14px;
    animation-delay: 0.12s;
}

.ai-countup__sparkle--4 {
    bottom: 0;
    right: 0;
    --cu-x: 16px;
    --cu-y: 14px;
    animation-delay: 0.18s;
}

/* 文案贴纸：从数字块上方弹出 */
.ai-countup__badge-wrap {
    position: absolute;
    left: 50%;
    bottom: 100%;
    margin-bottom: 6px;
    transform: translateX(-50%);
}

.ai-countup__badge {
    display: inline-block;
    padding: 2px 10px;
    color: #725d42;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.04em;
    line-height: 1.4;
    white-space: nowrap;
    background: linear-gradient(180deg, #ffe08a 0%, #f7cd67 100%);
    border: 1.5px solid #e0b800;
    border-radius: 50px;
    box-shadow: 0 2px 6px rgba(61, 52, 40, 0.18);
    animation: ai-countup-badge 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
}

@keyframes ai-countup-pop {
    0% {
        transform: scale(1) rotate(0deg);
    }

    16% {
        transform: scale(1.14) rotate(-2deg);
    }

    34% {
        transform: scale(0.98) rotate(0deg);
    }

    52% {
        transform: scale(1.08) rotate(1.6deg);
    }

    72% {
        transform: scale(0.99) rotate(-0.8deg);
    }

    100% {
        transform: scale(1) rotate(0deg);
    }
}

@keyframes ai-countup-ring {
    from {
        opacity: 0.9;
        transform: scale(1);
    }

    to {
        opacity: 0;
        transform: scale(1.5);
    }
}

@keyframes ai-countup-sparkle {
    0% {
        opacity: 0;
        transform: translate(0, 0) scale(0.4) rotate(0deg);
    }

    35% {
        opacity: 1;
    }

    100% {
        opacity: 0;
        transform: translate(var(--cu-x, 0), var(--cu-y, 0)) scale(1) rotate(90deg);
    }
}

@keyframes ai-countup-badge {
    0% {
        opacity: 0;
        transform: scale(0.4) rotate(-8deg);
    }

    55% {
        opacity: 1;
        transform: scale(1.12) rotate(3deg);
    }

    76% {
        transform: scale(0.96) rotate(-2deg);
    }

    100% {
        opacity: 1;
        transform: scale(1) rotate(0deg);
    }
}

/* 读屏专用：滚动中的数字不打扰，静止后播报完整数值 */
.ai-countup__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
}
