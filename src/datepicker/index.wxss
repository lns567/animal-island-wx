@import '../common/style/base.wxss';

/* ============================================
 * ai-datepicker —— 对应 Web 版 DatePicker
 * 单日 / 月份选择（范围选择留到二期，见 docs/migration-from-react.md）
 * ============================================ */

:host {
    display: inline-block;
    vertical-align: middle;
}

.ai-datepicker {
    position: relative;
    display: inline-block;
    font-family: var(--animal-font-family, sans-serif);
}

/* ---------- 触发器 ---------- */
.ai-datepicker__trigger {
    display: flex;
    align-items: center;
    width: 100%;
    background: #fffbe7;
    border-radius: 50px;
    transition: box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.ai-datepicker__trigger--small {
    height: 32px;
    padding: 0 14px;
    font-size: 12px;
}

.ai-datepicker__trigger--middle {
    height: 40px;
    padding: 0 18px;
    font-size: 14px;
}

.ai-datepicker__trigger--large {
    height: 48px;
    padding: 0 22px;
    font-size: 16px;
}

.ai-datepicker__trigger--hover {
    box-shadow: 0 3px 0 0 #c4b89e;
}

.ai-datepicker__trigger--open {
    box-shadow: 0 3px 0 0 #e0b800, 0 0 0 3px rgba(255, 204, 0, 0.15);
}

.ai-datepicker__trigger--error {
    box-shadow: 0 3px 0 0 #c94444;
}

.ai-datepicker__trigger--warning {
    box-shadow: 0 3px 0 0 #dba90e;
}

.ai-datepicker__text {
    flex: 1;
    color: #c4b89e;
    font-weight: 400;
    letter-spacing: 0.01em;
}

.ai-datepicker__text--value {
    color: #8a7b66;
    font-weight: 500;
}

/* 日历图标：纯 CSS 小方块 + 两个挂钩 */
.ai-datepicker__calendar {
    position: relative;
    flex: none;
    width: 14px;
    height: 13px;
    margin-left: 8px;
    border: 1.4px solid #a0936e;
    border-radius: 3px;
}

.ai-datepicker__calendar::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 3px;
    height: 1.2px;
    background: #a0936e;
}

.ai-datepicker__clear {
    flex: none;
    width: 20px;
    height: 20px;
    margin-left: 4px;
    border-radius: 50%;
    color: #c4b89e;
    font-size: 13px;
    font-weight: 700;
    line-height: 20px;
    text-align: center;
}

.ai-datepicker--disabled .ai-datepicker__trigger {
    opacity: 0.6;
    background: #ece8dc;
}

/* ---------- 关闭用遮罩 ---------- */
.ai-datepicker__catcher {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 100;
    background: transparent;
}

/* ---------- 面板 ---------- */
.ai-datepicker__panel {
    position: absolute;
    z-index: 101;
    box-sizing: border-box;
    width: 280px;
    padding: 14px;
    background: #fffdf7;
    border: 1.5px solid #e8dcc8;
    border-radius: 20px;
    box-shadow: 0 6px 18px rgba(61, 52, 40, 0.12);
    top: 100%;
    left: 0;
    margin-top: 6px;
    animation: animal-datepicker-in 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.ai-datepicker__panel--up {
    top: auto;
    bottom: 100%;
    margin-top: 0;
    margin-bottom: 6px;
}

.ai-datepicker__panel--right {
    left: auto;
    right: 0;
}

/* ---------- 头部 ---------- */
.ai-datepicker__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.ai-datepicker__nav-group {
    display: flex;
}

.ai-datepicker__nav {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    color: #a0936e;
    font-size: 15px;
    font-weight: 700;
    line-height: 26px;
    text-align: center;
}

.ai-datepicker__nav--hover {
    background: rgba(114, 93, 66, 0.1);
}

.ai-datepicker__label {
    flex: 1;
    padding: 4px 10px;
    border-radius: 10px;
    text-align: center;
}

.ai-datepicker__label--hover {
    background: #e6f9f6;
}

.ai-datepicker__label-text {
    color: #725d42;
    font-size: 14px;
    font-weight: 700;
}

/* ---------- 星期表头 ---------- */
.ai-datepicker__week-row {
    display: flex;
    margin-bottom: 4px;
}

.ai-datepicker__week-cell {
    flex: 1;
    height: 24px;
    color: #a09080;
    font-size: 11px;
    font-weight: 700;
    line-height: 24px;
    text-align: center;
}

/* ---------- 日期网格（flex 7 列） ---------- */
.ai-datepicker__grid {
    display: flex;
    flex-wrap: wrap;
}

.ai-datepicker__day {
    flex: none;
    width: 14.2857%;
    height: 34px;
    border-radius: 50%;
    color: #725d42;
    font-size: 13px;
    font-weight: 500;
    line-height: 34px;
    text-align: center;
}

.ai-datepicker__day--outside {
    color: #c4b89e;
    font-weight: 400;
}

.ai-datepicker__day--today {
    box-shadow: inset 0 0 0 1.5px #19c8b9;
    color: #19c8b9;
    font-weight: 700;
}

.ai-datepicker__day--selected {
    background: #19c8b9;
    box-shadow: none;
    color: #fff;
    font-weight: 700;
}

.ai-datepicker__day--disabled {
    background: transparent;
    color: #d4c9b4;
}

/* ---------- 月份网格 3×4 ---------- */
.ai-datepicker__month-grid {
    display: flex;
    flex-wrap: wrap;
    padding: 4px 0 8px;
}

.ai-datepicker__month {
    width: 33.3333%;
    height: 56px;
    border-radius: 16px;
    color: #725d42;
    font-size: 13px;
    font-weight: 500;
    line-height: 56px;
    text-align: center;
}

.ai-datepicker__month--selected {
    background: #19c8b9;
    color: #fff;
    font-weight: 700;
}

/* ---------- 底部 ---------- */
.ai-datepicker__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #f0e8d8;
}

.ai-datepicker__spacer {
    flex: 1;
}

.ai-datepicker__btn {
    flex: none;
    padding: 6px 14px;
    border-radius: 10px;
    color: #8a7b66;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
}

.ai-datepicker__btn--hover {
    background: rgba(114, 93, 66, 0.1);
    color: #725d42;
}

@keyframes animal-datepicker-in {
    from {
        opacity: 0;
        transform: translateY(-6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}
