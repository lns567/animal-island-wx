@import '../common/style/base.wxss';

/* ============================================
 * ai-divider —— 对应 Web 版 Divider
 * 全部为纯 CSS / 内联 SVG，无图片文件
 * ============================================ */

:host {
    display: block;
    width: 100%;
}

/* ---------- 线型 ---------- */
.ai-divider {
    width: 100%;
    height: 12px;
    background-image: linear-gradient(to right, #c4b89e 50%, rgba(196, 184, 158, 0) 50%);
    background-size: 12px 2px;
    background-repeat: repeat-x;
    background-position: center;
}

/* thin —— 1px 实心细线 */
.ai-divider--thin {
    height: 1px;
    background-image: none;
    background-color: #e8dec7;
}

/* hairline —— 1px 细密虚线 */
.ai-divider--hairline {
    height: 1px;
    background-image: linear-gradient(to right, #d5c3a2 50%, rgba(213, 195, 162, 0) 50%);
    background-size: 6px 1px;
}

/* wave-yellow —— 黄色波浪线（与 Web 版同一份内联 SVG） */
.ai-divider--wave-yellow {
    height: 14px;
    background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCA0MCAxNCcgcHJlc2VydmVBc3BlY3RSYXRpbz0nbm9uZSc+PHBhdGggZD0nTTAgNyBRMTAgMCAyMCA3IFQ0MCA3JyBmaWxsPSdub25lJyBzdHJva2U9JyNmNWQwNGEnIHN0cm9rZS13aWR0aD0nMi41JyBzdHJva2UtbGluZWNhcD0ncm91bmQnLz48L3N2Zz4=');
    background-repeat: repeat-x;
    background-size: 40px 14px;
    background-position: center;
}

/* squiggle —— 主题青色波浪线 */
.ai-divider--squiggle {
    height: 10px;
    background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAxMjAgMTAnPjxwYXRoIGQ9J00wIDIuNSBDIDMwIDIuNSwgMzAgNy41LCA2MCA3LjUgQyA5MCA3LjUsIDkwIDIuNSwgMTIwIDIuNScgZmlsbD0nbm9uZScgc3Ryb2tlPScjMTljOGI5JyBzdHJva2Utd2lkdGg9JzUnIHN0cm9rZS1saW5lY2FwPSdyb3VuZCcvPjwvc3ZnPg==');
    background-repeat: repeat-x;
    background-size: 120px 10px;
    background-position: center;
}

/* ---------- 图标循环模式 ---------- */
.ai-divider-block {
    width: 100%;
}

.ai-divider-icon {
    display: flex;
    align-items: center;
    width: 100%;
    overflow: hidden;
    min-height: 20px;
}

.ai-divider-icon__cycle {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
}

.ai-divider-icon__gap {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
}

.ai-divider-icon__line {
    flex: 0 0 auto;
    width: 4px;
    height: 2px;
    background-color: #c4b89e;
}
