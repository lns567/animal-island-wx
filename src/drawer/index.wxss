@import '../common/style/base.wxss';

/* ============================================
 * ai-drawer —— 对应 Web 版 Drawer
 * 四向抽屉 + 浅黑遮罩（遮罩用 transition，退场自动反向播放）
 * ============================================ */

:host {
    display: contents;
}

.ai-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.36s ease, visibility 0.36s ease;
}

.ai-drawer--open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

/* ---------- Panel ---------- */
.ai-drawer__panel {
    position: fixed;
    z-index: 1001;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    background: rgb(247, 243, 223);
    color: rgb(128, 115, 89);
    overflow: hidden;
    transition: transform 0.36s cubic-bezier(0.2, 0, 0.2, 1);
}

.ai-drawer__panel--right {
    top: 0;
    right: 0;
    height: 100vh;
    max-width: calc(100vw - 32px);
    border-radius: 20px 0 0 20px;
    box-shadow: -12px 0 32px rgba(61, 52, 40, 0.18);
    transform: translateX(100%);
}

.ai-drawer__panel--left {
    top: 0;
    left: 0;
    height: 100vh;
    max-width: calc(100vw - 32px);
    border-radius: 0 20px 20px 0;
    box-shadow: 12px 0 32px rgba(61, 52, 40, 0.18);
    transform: translateX(-100%);
}

.ai-drawer__panel--top {
    top: 0;
    left: 0;
    right: 0;
    max-height: calc(100vh - 32px);
    border-radius: 0 0 20px 20px;
    box-shadow: 0 12px 32px rgba(61, 52, 40, 0.18);
    transform: translateY(-100%);
}

.ai-drawer__panel--bottom {
    bottom: 0;
    left: 0;
    right: 0;
    max-height: calc(100vh - 32px);
    border-radius: 20px 20px 0 0;
    box-shadow: 0 -12px 32px rgba(61, 52, 40, 0.18);
    transform: translateY(100%);
}

.ai-drawer--open .ai-drawer__panel {
    transform: none;
}

/* ---------- Header ---------- */
.ai-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 24px 24px 15px;
}

.ai-drawer__title {
    font-size: 28px;
    font-weight: 700;
    color: rgba(114, 93, 66, 1);
}

.ai-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 22px;
    line-height: 1;
    color: rgba(114, 93, 66, 0.6);
}

/* ---------- Body ---------- */
.ai-drawer__body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0 24px 24px;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.6;
    color: #8a7b66;
}

/* ---------- Footer ---------- */
.ai-drawer__footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    flex-shrink: 0;
    padding: 0 24px 24px;
}
