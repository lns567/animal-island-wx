@import '../common/style/base.wxss';

/* ============================================
 * ai-radio —— 对应 Web 版 Radio
 * 圆形勾选框 + splash 小圆点爆开
 * ============================================ */

:host {
    display: block;
}

.ai-radio {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-family: inherit;
}

.ai-radio--horizontal {
    flex-direction: row;
}

.ai-radio--vertical {
    flex-direction: column;
    gap: 12px;
}

/* ---------- Item ---------- */
.ai-radio__item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    user-select: none;
}

/* ---------- Sizes ---------- */
.ai-radio__item--small {
    --cbx-size: 18px;
    --cbx-check-w: 10px;
    --cbx-check-h: 9px;
}

.ai-radio__item--small .ai-radio__label {
    font-size: 12px;
}

.ai-radio__item--middle {
    --cbx-size: 22px;
    --cbx-check-w: 12px;
    --cbx-check-h: 11px;
}

.ai-radio__item--middle .ai-radio__label {
    font-size: 14px;
}

.ai-radio__item--large {
    --cbx-size: 28px;
    --cbx-check-w: 15px;
    --cbx-check-h: 14px;
}

.ai-radio__item--large .ai-radio__label {
    font-size: 16px;
}

/* ---------- 圆形框 ---------- */
.ai-radio__box {
    position: relative;
    flex-shrink: 0;
    width: var(--cbx-size, 22px);
    height: var(--cbx-size, 22px);
    box-sizing: border-box;
    border: 2px solid #c4b89e;
    border-radius: 50%;
    background: rgb(247, 243, 223);
    transition: border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.ai-radio__item--checked .ai-radio__box {
    border-color: #50b9ab;
    background: #19c8b9;
}

/* splash：勾选时六个小圆点向外爆开 */
.ai-radio__splash {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: var(--cbx-size, 22px);
    height: var(--cbx-size, 22px);
    background: none;
    border-radius: 50%;
    pointer-events: none;
}

.ai-radio__item--checked .ai-radio__splash {
    animation: animal-radio-splash 0.6s ease forwards;
}

/* ---------- 勾 ---------- */
.ai-radio__tick {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--cbx-check-w, 12px);
    height: var(--cbx-check-h, 11px);
    transform: translate(-50%, -54%);
    z-index: 1;
    background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNSIgaGVpZ2h0PSIxNCIgdmlld0JveD0iMCAwIDE1IDE0IiBmaWxsPSJub25lIj48cGF0aCBkPSJNMiA4LjM2MzY0TDYuMjMwNzcgMTJMMTMgMiIgc3Ryb2tlPSIjRkZGRkZGIiBzdHJva2Utd2lkdGg9IjMiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCIvPjwvc3ZnPg==');
    background-size: 100% 100%;
    background-repeat: no-repeat;
    pointer-events: none;
    animation: animal-radio-tick 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ---------- Label ---------- */
.ai-radio__label {
    color: #725d42;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color 0.15s;
}

.ai-radio__item--checked .ai-radio__label {
    color: #794f27;
}

/* ---------- Disabled ---------- */
.ai-radio__item--disabled {
    opacity: 0.55;
}

.ai-radio__item--disabled .ai-radio__box {
    background: #f0ece2;
    border-color: #d4c9b4;
}

.ai-radio__item--disabled .ai-radio__splash {
    animation: none;
}

.ai-radio__item--disabled .ai-radio__tick {
    background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNSIgaGVpZ2h0PSIxNCIgdmlld0JveD0iMCAwIDE1IDE0IiBmaWxsPSJub25lIj48cGF0aCBkPSJNMiA4LjM2MzY0TDYuMjMwNzcgMTJMMTMgMiIgc3Ryb2tlPSIjQzRCODlFIiBzdHJva2Utd2lkdGg9IjMiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCIvPjwvc3ZnPg==');
}

.ai-radio__item--disabled .ai-radio__label {
    color: #c4b89e;
}

@keyframes animal-radio-splash {
    40% {
        background: #19c8b9;
        box-shadow:
            0 -18px 0 -8px #19c8b9,
            16px -8px 0 -8px #19c8b9,
            16px 8px 0 -8px #19c8b9,
            0 18px 0 -8px #19c8b9,
            -16px 8px 0 -8px #19c8b9,
            -16px -8px 0 -8px #19c8b9;
    }

    100% {
        background: #19c8b9;
        box-shadow:
            0 -36px 0 -10px transparent,
            32px -16px 0 -10px transparent,
            32px 16px 0 -10px transparent,
            0 36px 0 -10px transparent,
            -32px 16px 0 -10px transparent,
            -32px -16px 0 -10px transparent;
    }
}

@keyframes animal-radio-tick {
    from {
        opacity: 0;
        transform: translate(-50%, -54%) scale(0.6);
    }

    to {
        opacity: 1;
        transform: translate(-50%, -54%) scale(1);
    }
}
