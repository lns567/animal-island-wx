@import '../common/style/base.wxss';

/* ============================================
 * ai-rate —— 对应 Web 版 Rate
 * 星星点亮：弹跳 + 六点扩散
 * ============================================ */

:host {
    display: inline-block;
}

.ai-rate {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 1;
}

/* ---------- Sizes ---------- */
.ai-rate--small {
    --rate-size: 20px;
    --rate-gap: 4px;
    --rate-splash-scale: 0.91;
    gap: 4px;
}

.ai-rate--middle {
    --rate-size: 26px;
    --rate-gap: 6px;
    --rate-splash-scale: 1.18;
    gap: 6px;
}

.ai-rate--large {
    --rate-size: 34px;
    --rate-gap: 8px;
    --rate-splash-scale: 1.55;
    gap: 8px;
}

/* ---------- Item ---------- */
.ai-rate__item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--rate-size, 26px);
    height: var(--rate-size, 26px);
}

/* ---------- Star：两层叠着交叉淡入，还原 Web 版的 fill-opacity 过渡 ---------- */
.ai-rate__star {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
}

.ai-rate__star--idle {
    background-image: url('data:image/svg+xml;base64,');
}

.ai-rate__star--active {
    background-image: url('data:image/svg+xml;base64,');
    opacity: 0;
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.ai-rate__item--active .ai-rate__star--active {
    opacity: 1;
}

/* ---------- 弹跳 ---------- */
.ai-rate__star--pop {
    animation: animal-rate-pop 0.35s cubic-bezier(0.4, 0, 0.2, 1) both;
}

@keyframes animal-rate-pop {
    0% {
        transform: scale(0.55);
    }

    60% {
        transform: scale(1.15);
    }

    100% {
        transform: scale(1);
    }
}

/* ---------- 六点扩散 ---------- */
.ai-rate__splash {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border-radius: 50%;
    transform: scale(var(--rate-splash-scale, 1.18));
    animation: animal-rate-splash 0.6s ease forwards;
    pointer-events: none;
}

@keyframes animal-rate-splash {
    40% {
        box-shadow:
            0 -18px 0 -8px #f5c31c,
            16px -8px 0 -8px #f5c31c,
            16px 8px 0 -8px #f5c31c,
            0 18px 0 -8px #f5c31c,
            -16px 8px 0 -8px #f5c31c,
            -16px -8px 0 -8px #f5c31c;
    }

    100% {
        box-shadow:
            0 -36px 0 -10px transparent,
            32px -16px 0 -10px transparent,
            32px 16px 0 -10px transparent,
            0 36px 0 -10px transparent,
            -32px 16px 0 -10px transparent,
            -32px -16px 0 -10px transparent;
    }
}

/* ---------- Readonly ---------- */
.ai-rate--readonly .ai-rate__item {
    opacity: 0.9;
}
@keyframes animal-rate-pop {
    0% { transform: scale(0.55); }
    60% { transform: scale(1.15); }
    100% { transform: scale(1); }
}

.ai-rate__item--hover {
    opacity: 0.85;
}
