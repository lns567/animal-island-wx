<view class="ai-timepicker extClass{{disabled ? ' ai-timepicker--disabled' : ''}}" style="{{extStyle}}">
    <view
        class="ai-timepicker__trigger ai-timepicker__trigger--{{size}}{{status ? ' ai-timepicker__trigger--' + status : ''}}{{open ? ' ai-timepicker__trigger--open' : ''}}"
        bindtap="toggle"
        hover-class="{{disabled ? 'none' : 'ai-timepicker__trigger--hover'}}"
        aria-role="combobox"
        aria-label="{{ariaLabel || placeholder}}"
        aria-expanded="{{open}}"
    >
        <text class="ai-timepicker__text{{display ? ' ai-timepicker__text--value' : ''}}">{{display || placeholder}}</text>
        <view wx:if="{{allowClear && display && !disabled}}" class="ai-timepicker__clear" catchtap="handleClear">×</view>
        <view class="ai-timepicker__clock"></view>
    </view>

    <view wx:if="{{open}}" class="ai-timepicker__catcher" bindtap="close" catchtouchmove="noop"></view>

    <view
        wx:if="{{open && placed}}"
        class="ai-timepicker__panel{{dropUp ? ' ai-timepicker__panel--up' : ''}}"
        style="left:{{offsetX}}px;"
        catchtap="noop"
        aria-role="dialog"
        aria-label="选择时间"
    >
        <view class="ai-timepicker__columns">
            <view class="ai-timepicker__column">
                <text class="ai-timepicker__col-title">时</text>
                <scroll-view class="ai-timepicker__list" scroll-y="{{true}}" scroll-top="{{scrollH}}" enhanced="{{true}}" show-scrollbar="{{false}}">
                    <view
                        wx:for="{{hours}}"
                        wx:key="key"
                        class="ai-timepicker__option{{item.value === pending.h ? ' ai-timepicker__option--active' : ''}}"
                        data-value="{{item.value}}"
                        bindtap="pickHour"
                    >{{item.label}}</view>
                </scroll-view>
            </view>
            <view class="ai-timepicker__column">
                <text class="ai-timepicker__col-title">分</text>
                <scroll-view class="ai-timepicker__list" scroll-y="{{true}}" scroll-top="{{scrollM}}" enhanced="{{true}}" show-scrollbar="{{false}}">
                    <view
                        wx:for="{{minutes}}"
                        wx:key="key"
                        class="ai-timepicker__option{{item.value === pending.m ? ' ai-timepicker__option--active' : ''}}"
                        data-value="{{item.value}}"
                        bindtap="pickMinute"
                    >{{item.label}}</view>
                </scroll-view>
            </view>
            <view wx:if="{{showSeconds}}" class="ai-timepicker__column">
                <text class="ai-timepicker__col-title">秒</text>
                <scroll-view class="ai-timepicker__list" scroll-y="{{true}}" scroll-top="{{scrollS}}" enhanced="{{true}}" show-scrollbar="{{false}}">
                    <view
                        wx:for="{{seconds}}"
                        wx:key="key"
                        class="ai-timepicker__option{{item.value === pending.s ? ' ai-timepicker__option--active' : ''}}"
                        data-value="{{item.value}}"
                        bindtap="pickSecond"
                    >{{item.label}}</view>
                </scroll-view>
            </view>
        </view>

        <view class="ai-timepicker__footer">
            <view class="ai-timepicker__btn" bindtap="setNow" hover-class="ai-timepicker__btn--hover">此刻</view>
            <view class="ai-timepicker__btn ai-timepicker__btn--primary" bindtap="confirm" hover-class="ai-timepicker__btn--hover">确定</view>
        </view>
    </view>
</view>
